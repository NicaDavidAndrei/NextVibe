@model NextVibe.Models.AlbumTrack

@{
    ViewData["Title"] = "Delete Track";

    var minutes = Model.DurationSeconds / 60;
    var seconds = Model.DurationSeconds % 60;
    var duration = Model.DurationSeconds > 0
        ? string.Format("{0}:{1:00}", minutes, seconds)
        : "N/A";
}

<div class="py-5">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">Delete Track</h1>
            <p class="text-muted mb-0">
                Confirm if you want to remove this track.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-light">
            Back to Tracks
        </a>
    </div>

    <div class="card bg-dark text-white border-danger shadow-sm">
        <div class="card-body p-4">

            <div class="alert alert-danger mb-4">
                Are you sure you want to delete this track? This action cannot be undone.
            </div>

            <div class="card bg-black border-secondary mb-4">
                <div class="card-body">

                    <h2 class="fw-bold mb-1">@Model.Name</h2>

                    <p class="text-muted mb-3">
                        @(Model.ArtistAlbum?.Artist?.Name ?? "Unknown Artist")
                        •
                        @(Model.ArtistAlbum?.Title ?? "Unknown Album")
                    </p>

                    <div class="row g-3">

                        <div class="col-12 col-md-4">
                            <h6 class="text-muted mb-1">Track Number</h6>
                            <p class="mb-0 fw-semibold">@Model.TrackNumber</p>
                        </div>

                        <div class="col-12 col-md-4">
                            <h6 class="text-muted mb-1">Duration</h6>
                            <p class="mb-0 fw-semibold">@duration</p>
                        </div>

                        <div class="col-12 col-md-4">
                            <h6 class="text-muted mb-1">Top Track</h6>

                            @if (Model.IsTopTrack)
                            {
                                <span class="badge rounded-pill nv-pill">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill">No</span>
                            }
                        </div>

                    </div>

                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-danger">
                        Delete Track
                    </button>

                    <a asp-action="Index" class="btn btn-outline-light">
                        Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>

</div>