@model IEnumerable<NextVibe.Models.ApplicationUser>

@{
    ViewData["Title"] = "Users";
}

<div class="py-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Users</h1>
            <p class="text-muted mb-0">
                View and manage registered users.
            </p>
        </div>

        <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-outline-light">
            Back to Admin Panel
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-4">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card bg-dark text-white border-secondary shadow-sm">
            <div class="card-body p-5 text-center">
                <img src="~/images/logo-icon.png" alt="NextVibe" class="nv-badge-img mx-auto mb-3 d-block" style="height:56px;width:auto;" />
                <h2 class="h5 fw-bold mb-2">No users found</h2>
                <p class="text-muted mb-0">
                    There are no registered users in the application yet.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card bg-dark text-white border-secondary shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="px-4 py-3">First Name</th>
                                <th class="px-4 py-3">Last Name</th>
                                <th class="px-4 py-3">Email</th>
                                <th class="px-4 py-3">Username</th>
                                <th class="px-4 py-3 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3 fw-semibold">
                                        @(string.IsNullOrWhiteSpace(item.FirstName) ? "—" : item.FirstName)
                                    </td>

                                    <td class="px-4 py-3 text-muted">
                                        @(string.IsNullOrWhiteSpace(item.LastName) ? "—" : item.LastName)
                                    </td>

                                    <td class="px-4 py-3 text-muted">
                                        @item.Email
                                    </td>

                                    <td class="px-4 py-3 text-muted">
                                        @item.UserName
                                    </td>

                                    <td class="px-4 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-2 flex-wrap">
                                            <a asp-action="Details"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-primary nv-btn-primary">
                                                Details
                                            </a>

                                            <a asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-danger">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

</div>