@model IEnumerable<NextVibe.Models.Artist>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Explore";

    var genres = ViewBag.Genres as SelectList;
    var moods = ViewBag.Moods as SelectList;

    string? searchString = ViewBag.SearchString as string;
    int? selectedGenreId = ViewBag.GenreId as int?;
    int? selectedMoodId = ViewBag.MoodId as int?;
}

<div class="py-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Explore</h1>
            <p class="text-muted mb-0">
                Discover artists and filter them by genre or mood.
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Artists"
                   asp-action="Index"
                   class="btn btn-outline-light">
                Manage Artists
            </a>
        }
    </div>

    <div class="card bg-dark text-white border-secondary shadow-sm mb-4">
        <div class="card-body p-3 p-md-4">

            <form id="exploreFilterForm" asp-action="Index" method="get">
                <div class="row g-3 align-items-end">

                    <div class="col-12 col-md-4">
                        <label class="form-label">Search</label>
                        <input type="text"
                               name="searchString"
                               value="@searchString"
                               class="form-control nv-input"
                               placeholder="Search artist..." />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">Genre</label>
                        <select name="genreId" class="form-select nv-input">
                            <option value="">Any</option>

                            @if (genres != null)
                            {
                                foreach (var genre in genres)
                                {
                                    if (genre.Value == selectedGenreId?.ToString())
                                    {
                                        <option value="@genre.Value" selected>@genre.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@genre.Value">@genre.Text</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label">Mood</label>
                        <select name="moodId" class="form-select nv-input">
                            <option value="">Any</option>

                            @if (moods != null)
                            {
                                foreach (var mood in moods)
                                {
                                    if (mood.Value == selectedMoodId?.ToString())
                                    {
                                        <option value="@mood.Value" selected>@mood.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@mood.Value">@mood.Text</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-2">
                        <button type="submit" class="btn btn-primary nv-btn-primary w-100">
                            Filter
                        </button>
                    </div>

                </div>
            </form>

        </div>
    </div>

    <div id="artistsContainer">
        @await Html.PartialAsync("_ArtistCards", Model)
    </div>

</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        function loadArtists() {
        const formData = $("#exploreFilterForm").serialize();

        $.ajax({
        url: "/Explore/FilterArtists",
        type: "GET",
        data: formData,
        success: function (result) {
        $("#artistsContainer").html(result);
        },
        error: function () {
        $("#artistsContainer").html(
        "<div class='alert alert-danger'>Could not load artists.</div>"
        );
        }
        });
        }

        $("#exploreFilterForm").on("submit", function (e) {
        e.preventDefault();
        loadArtists();
        });

        $("#exploreFilterForm input, #exploreFilterForm select").on("change keyup", function () {
        loadArtists();
        });
    </script>
}