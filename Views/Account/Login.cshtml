@model NextVibe.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">

            <div class="text-center mb-4">
                <img src="~/images/logo-icon.png" alt="NextVibe" class="nv-badge-img mx-auto mb-3 d-block" style="height:56px;width:auto;" />
                <h1 class="h3 fw-bold">Welcome back</h1>
                <p class="text-muted">Log in to access your vibe profile.</p>
            </div>

            <div class="card bg-dark text-white border-secondary shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control nv-input" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-2">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control nv-input" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label"></label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 nv-btn-primary">
                            Log in
                        </button>

                        <div class="text-center mt-3">
                            <span class="text-muted">Don't have an account?</span>
                            <a asp-controller="Account" asp-action="Register">Register</a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}