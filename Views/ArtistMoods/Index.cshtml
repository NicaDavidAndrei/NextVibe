@model IEnumerable<NextVibe.Models.Artist>

@{
    ViewData["Title"] = "Artist Moods";
}

<div class="py-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Artist Moods</h1>
            <p class="text-muted mb-0">
                Manage mood associations for each artist.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Create"
                   class="btn btn-primary nv-btn-primary">
                Create / Assign Mood
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card bg-dark text-white border-secondary shadow-sm">
            <div class="card-body p-5 text-center">
                <img src="~/images/logo-icon.png" alt="NextVibe" class="nv-badge-img mx-auto mb-3 d-block" style="height:56px;width:auto;" />
                <h2 class="h5 fw-bold mb-2">No artists found</h2>
                <p class="text-muted mb-4">
                    Add artists first, then assign moods.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card bg-dark text-white border-secondary shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="px-4 py-3">Artist</th>
                                <th class="px-4 py-3">Assigned Moods</th>
                                <th class="px-4 py-3 text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var artist in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3 fw-semibold">
                                        @artist.Name
                                    </td>

                                    <td class="px-4 py-3">
                                        @if (artist.ArtistMoods != null && artist.ArtistMoods.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var am in artist.ArtistMoods)
                                                {
                                                    <div class="d-flex align-items-center gap-1 border border-secondary rounded-pill px-2 py-1">
                                                        <span class="badge nv-pill">
                                                            @(am.Mood?.Name ?? "Unknown")
                                                        </span>

                                                        <a asp-action="Delete"
                                                               asp-route-id="@am.Id"
                                                               class="btn btn-sm btn-danger py-0 px-2">
                                                            Delete
                                                        </a>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No moods assigned</span>
                                        }
                                    </td>

                                    <td class="px-4 py-3 text-end">
                                        <a asp-action="Create"
                                               class="btn btn-sm btn-primary nv-btn-primary">
                                            Assign New Mood
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>
    }

</div>