@model IEnumerable<NextVibe.Models.Artist>

@{
    ViewData["Title"] = "Artists";

    var userType = Context.Request.Query["userType"].ToString();
    if (string.IsNullOrWhiteSpace(userType))
    {
        userType = "Guest";
    }
}

<div class="py-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Artists</h1>
            <p class="text-muted mb-0">
                Manage the artists stored in the application database.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Admin"
                   asp-action="Index"
                   asp-route-userType="@userType"
                   class="btn btn-outline-light">
                Back to Admin Panel
            </a>

            <a asp-action="Create"
                   asp-route-userType="@userType"
                   class="btn btn-primary nv-btn-primary">
                Create New
            </a>
        </div>
    </div>

    <div class="card bg-dark text-white border-secondary shadow-sm mb-4">
        <div class="card-body p-4">
            <form asp-action="Index" method="get">
                <input type="hidden" name="userType" value="@userType" />

                <div class="row g-3 align-items-end">

                    <div class="col-12 col-lg-7">
                        <label class="form-label">Search artists</label>
                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control bg-black text-white border-secondary"
                               placeholder="Search by artist, country or bio..." />
                    </div>

                    <div class="col-12 col-lg-3">
                        <label class="form-label">Genre</label>
                        <select name="genreId"
                                class="form-select bg-black text-white border-secondary"
                                asp-items="ViewBag.Genres">
                            <option value="">All genres</option>
                        </select>
                    </div>

                    <div class="col-12 col-lg-2">
                        <button type="submit" class="btn btn-primary nv-btn-primary w-100">
                            Search
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card bg-dark text-white border-secondary shadow-sm">
            <div class="card-body p-5 text-center">
                <img src="~/images/logo-icon.png" alt="NextVibe" class="nv-badge-img mx-auto mb-3 d-block" style="height:56px;width:auto;" />
                <h2 class="h5 fw-bold mb-2">No artists found</h2>
                <p class="text-muted mb-4">
                    Try another search, change the genre filter, or add a new artist.
                </p>

                <a asp-action="Create"
                       asp-route-userType="@userType"
                       class="btn btn-primary nv-btn-primary">
                    Create New Artist
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card bg-dark text-white border-secondary shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="px-4 py-3">Name</th>
                                <th class="px-4 py-3">Genre</th>
                                <th class="px-4 py-3">Country</th>
                                <th class="px-4 py-3">Birth Year</th>
                                <th class="px-4 py-3">Image</th>
                                <th class="px-4 py-3 text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3 fw-semibold">
                                        @item.Name
                                    </td>

                                    <td class="px-4 py-3 text-muted">
                                        @(item.Genre?.Name ?? "Unknown")
                                    </td>

                                    <td class="px-4 py-3 text-muted">
                                        @(string.IsNullOrWhiteSpace(item.Country) ? "Unknown" : item.Country)
                                    </td>

                                    <td class="px-4 py-3 text-muted">
                                        @(item.BirthYear.HasValue ? item.BirthYear.ToString() : "—")
                                    </td>

                                    <td class="px-4 py-3 text-muted">
                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <span class="badge rounded-pill nv-pill">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill">No</span>
                                        }
                                    </td>

                                    <td class="px-4 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-2 flex-wrap">
                                            <a asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   asp-route-userType="@userType"
                                                   class="btn btn-sm btn-outline-light">
                                                Edit
                                            </a>

                                            <a asp-action="Details"
                                                   asp-route-id="@item.Id"
                                                   asp-route-userType="@userType"
                                                   class="btn btn-sm btn-primary nv-btn-primary">
                                                Details
                                            </a>

                                            <a asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   asp-route-userType="@userType"
                                                   class="btn btn-sm btn-danger">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>
    }

</div>