@model IEnumerable<NextVibe.Models.Artist>

@{
    var favoriteArtistIds = ViewBag.FavoriteArtistIds as List<int> ?? new List<int>();
}

<div class="row g-3">
    @foreach (var artist in Model)
    {
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card bg-dark text-white border-secondary h-100 shadow-sm">

                @if (!string.IsNullOrWhiteSpace(artist.ImageUrl))
                {
                    <img src="@artist.ImageUrl"
                         class="card-img-top"
                         alt="@artist.Name"
                         style="height: 220px; object-fit: cover;" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-secondary text-white"
                         style="height: 220px;">
                        No Image
                    </div>
                }

                <div class="card-body d-flex flex-column">

                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <h5 class="card-title mb-1">@artist.Name</h5>

                        <span class="badge rounded-pill nv-pill">
                            @(artist.Genre?.Name ?? "Unknown")
                        </span>
                    </div>

                    <p class="text-muted small mb-2">
                        @(string.IsNullOrWhiteSpace(artist.Country) ? "Unknown country" : artist.Country)

                        @if (artist.BirthYear.HasValue)
                        {
                            <span> • @artist.BirthYear</span>
                        }
                    </p>

                    @if (artist.ArtistMoods != null && artist.ArtistMoods.Any())
                    {
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            @foreach (var artistMood in artist.ArtistMoods.Take(3))
                            {
                                <span class="badge bg-secondary rounded-pill">
                                    @(artistMood.Mood?.Name ?? "Mood")
                                </span>
                            }
                        </div>
                    }

                    <p class="text-muted flex-grow-1">
                        @{
                            var bio = string.IsNullOrWhiteSpace(artist.Bio)
                                ? "No description available."
                                : artist.Bio;

                            if (bio.Length > 110)
                            {
                                bio = bio.Substring(0, 110) + "...";
                            }
                        }
                        @bio
                    </p>

                    <div class="d-flex gap-2 mt-auto">

                        <a asp-controller="Explore"
                               asp-action="Details"
                               asp-route-id="@artist.Id"
                               class="btn btn-sm btn-outline-light flex-fill">
                            Details
                        </a>

                        @if (!User.Identity!.IsAuthenticated)
                        {
                            <a asp-controller="Account"
                                   asp-action="Login"
                                   class="btn btn-sm btn-primary nv-btn-primary flex-fill">
                                Login to Add
                            </a>
                        }
                        else if (favoriteArtistIds.Contains(artist.Id))
                        {
                            <a asp-controller="UserFavoriteArtists"
                                   asp-action="RemoveByArtist"
                                   asp-route-artistId="@artist.Id"
                                   class="btn btn-sm btn-danger flex-fill">
                                Remove
                            </a>
                        }
                        else
                        {
                            <a asp-controller="UserFavoriteArtists"
                                   asp-action="Add"
                                   asp-route-artistId="@artist.Id"
                                   class="btn btn-sm btn-primary nv-btn-primary flex-fill">
                                Add to Vibes
                            </a>
                        }

                    </div>

                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="card bg-dark text-white border-secondary shadow-sm mt-4">
        <div class="card-body text-center p-4">
            <h5 class="fw-bold mb-2">No artists found</h5>
            <p class="text-muted mb-0">
                Try a different search or filter.
            </p>
        </div>
    </div>
}