@model NextVibe.Models.ApplicationUser

@{
    ViewData["Title"] = "My Account";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
}

<div class="py-5">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">My Account</h1>
            <p class="text-muted mb-0">Profile details and activity overview.</p>
        </div>

        <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-light">
            Back to Home
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-4">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4">

        <div class="col-12 col-lg-7">
            <div class="card bg-dark text-white border-secondary shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                        <h4 class="fw-bold mb-0">Profile Information</h4>

                        @if (isAdmin)
                        {
                            <span class="role-badge admin">ADMIN ACCOUNT</span>
                        }
                        else
                        {
                            <span class="role-badge user">USER ACCOUNT</span>
                        }
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-4">First Name</dt>
                        <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.FirstName) ? Model.FirstName : "Not provided")</dd>

                        <dt class="col-sm-4">Last Name</dt>
                        <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.LastName) ? Model.LastName : "Not provided")</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Username</dt>
                        <dd class="col-sm-8">@Model.UserName</dd>
                    </dl>

                    <div class="d-flex gap-2 mt-4 flex-wrap">
                        <a asp-controller="Account"
                               asp-action="EditProfile"
                               class="btn btn-primary nv-btn-primary">
                            Edit Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card bg-dark text-white border-secondary shadow-sm h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">Your Stats</h4>

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="card bg-black border-secondary">
                                <div class="card-body">
                                    <h6 class="text-muted mb-2">Favorite Artists</h6>
                                    <h2 class="fw-bold mb-0">@ViewBag.FavoriteCount</h2>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="card bg-black border-secondary">
                                <div class="card-body">
                                    <h6 class="text-muted mb-2">Available Recommendations</h6>
                                    <h2 class="fw-bold mb-0">@ViewBag.RecommendationCount</h2>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4 flex-wrap">
                        <a asp-controller="UserFavoriteArtists"
                               asp-action="MyVibes"
                               class="btn btn-primary nv-btn-primary">
                            View My Vibes
                        </a>

                        <a asp-controller="Recommendations"
                               asp-action="Index"
                               class="btn btn-outline-light">
                            View Recommendations
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>