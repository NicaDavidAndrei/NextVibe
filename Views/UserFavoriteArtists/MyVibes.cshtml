@model IEnumerable<NextVibe.Models.UserFavoriteArtist>

@{
    ViewData["Title"] = "My Vibes";
}

<div class="py-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">My Vibes</h1>
            <p class="text-muted mb-0">Your saved artists collection.</p>
        </div>

        <a asp-controller="Explore"
               asp-action="Index"
               class="btn btn-primary nv-btn-primary">
            Explore artists
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card bg-dark text-white border-secondary shadow-sm">
            <div class="card-body p-5 text-center">
                <img src="~/images/logo-icon.png" alt="NextVibe" class="nv-badge-img mx-auto mb-3 d-block" style="height:56px;width:auto;" />

                <h2 class="h5 fw-bold mb-2">Your collection is empty</h2>
                <p class="text-muted mb-4">
                    Your favorite artists will appear here once you add them from the Explore page.
                </p>

                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a asp-controller="Explore"
                           asp-action="Index"
                           class="btn btn-primary nv-btn-primary">
                        Add your first artist
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var favorite in Model)
            {
                var artist = favorite.Artist;

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card bg-dark text-white border-secondary h-100 shadow-sm">

                        @if (!string.IsNullOrWhiteSpace(artist?.ImageUrl))
                        {
                            <img src="@artist.ImageUrl"
                                 class="card-img-top"
                                 alt="@artist.Name"
                                 style="height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-secondary text-white"
                                 style="height: 220px;">
                                No Image
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title mb-1">@artist?.Name</h5>
                                <span class="badge rounded-pill nv-pill">
                                    @(artist?.Genre?.Name ?? "Unknown")
                                </span>
                            </div>

                            <p class="text-muted small mb-2">
                                @(string.IsNullOrWhiteSpace(artist?.Country) ? "Unknown country" : artist?.Country)
                                @if (artist?.BirthYear != null)
                                {
                                    <span> • @artist.BirthYear</span>
                                }
                            </p>

                            <p class="text-muted flex-grow-1">
                                @{
                                    var bio = string.IsNullOrWhiteSpace(artist?.Bio)
                                        ? "No description available."
                                        : artist!.Bio!;

                                    if (bio.Length > 110)
                                    {
                                        bio = bio.Substring(0, 110) + "...";
                                    }
                                }
                                @bio
                            </p>

                            <p class="text-muted small">
                                Added on @favorite.AddedAt.ToString("dd/MM/yyyy HH:mm")
                            </p>

                            <div class="d-flex gap-2 mt-auto">
                                <a asp-controller="Explore"
                                       asp-action="Details"
                                       asp-route-id="@artist?.Id"
                                       class="btn btn-sm btn-outline-light">
                                    Details
                                </a>

                                <a asp-controller="UserFavoriteArtists"
                                       asp-action="Remove"
                                       asp-route-id="@favorite.Id"
                                       class="btn btn-sm btn-danger">
                                    Remove
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>