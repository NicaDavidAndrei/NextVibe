@model NextVibe.Models.ViewModels.Games.GameDashboardViewModel

@{
    ViewData["Title"] = "NextVibe Games";
}

<div class="games-hero">
    <h1>NextVibe Games 🎮</h1>
    <p class="text-muted" style="max-width: 600px; margin: 0 auto;">
        Test your music knowledge. Guess songs from tiny audio snippets, identify albums from a blur or a color palette, and finish the lines of your favorite songs.
    </p>

    <!-- Stats Bar -->
    @if (Model.IsAuthenticated)
    {
        <div class="games-stats-bar">
            <div class="stat-pill">
                <span class="stat-val">@Model.TotalGamesPlayed</span>
                <span class="stat-label">Games played</span>
            </div>
            <div class="stat-pill">
                <span class="stat-val">@Model.TotalScore</span>
                <span class="stat-label">Total points (XP)</span>
            </div>
            <div class="stat-pill">
                <span class="stat-val">@Model.BestScoreSong</span>
                <span class="stat-label">Song record</span>
            </div>
            <div class="stat-pill">
                <span class="stat-val">@Model.BestScoreAlbum</span>
                <span class="stat-label">Album record</span>
            </div>
        </div>
        <div class="text-center mb-3">
            <a asp-action="Stats" class="btn btn-sm btn-outline-info px-3">
                📊 View profile and full stats
            </a>
        </div>
    }
    else
    {
        <div class="alert alert-info d-inline-block mt-3" style="background: rgba(109, 94, 252, 0.15); border-color: rgba(109, 94, 252, 0.3); color: #c4b5fd;">
            💡 <strong>Tip:</strong> <a asp-controller="Account" asp-action="Login" class="text-white text-decoration-underline">Log in</a> to save your scores and stats, and to play with artists from <em>My Vibes</em>!
        </div>
    }
</div>

<!-- Artist / Library Filter Selector -->
<div class="card p-3 mb-4" style="background: #171a21; border: 1px solid rgba(255,255,255,0.08); border-radius: 14px;">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-2">
            <span style="font-size: 1.2rem;">🎯</span>
            <span class="fw-bold">Choose a library:</span>
        </div>
        <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 450px;">
            <select id="artistSelect" class="form-select" style="background: #202532; border-color: rgba(255,255,255,0.15); color: #fff;">
                <option value="">Full NextVibe collection (all artists)</option>
                @if (Model.IsAuthenticated && Model.UserFavoriteArtists.Any())
                {
                    <option value="-1">⭐ Only my favorite artists (My Vibes)</option>
                }
                <optgroup label="Individual artists">
                    @foreach (var artist in Model.AvailableArtists)
                    {
                        <option value="@artist.Id">@artist.Name</option>
                    }
                </optgroup>
            </select>
        </div>
    </div>
</div>

<!-- Games Grid -->
<div class="games-grid">
    <!-- Game 1: Guess the Song -->
    <div class="game-card">
        <span class="game-card-badge">0.1s - 10s Audio</span>
        <div>
            <div class="game-card-icon">🎵</div>
            <h3>Guess the Song</h3>
            <p>
                Listen to short snippets (0.1s &rarr; 0.5s &rarr; 1s &rarr; 3s &rarr; 5s &rarr; 10s) and name the song. Artist and album hints are there if you get stuck.
            </p>
        </div>
        <div class="game-card-actions">
            <div class="d-flex gap-2">
                <button onclick="startGame('song', 'choice')" class="btn btn-primary flex-grow-1">
                    🎧 Multiple Choice ▶
                </button>
                <button onclick="startGame('song', 'type')" class="btn btn-outline-secondary flex-grow-1">
                    ⌨️ Type the song ▶
                </button>
            </div>
        </div>
    </div>

    <!-- Game 2: Guess the Album (Blur Mode) -->
    <div class="game-card">
        <span class="game-card-badge">3 blur levels</span>
        <div>
            <div class="game-card-icon">🌫️</div>
            <h3>Guess the Album (Blur)</h3>
            <p>
                The cover starts heavily blurred (100 pts). There are 3 clarity levels (100 &rarr; 60 &rarr; 30 pts), and you can ask for the artist if you need it.
            </p>
        </div>
        <div class="game-card-actions">
            <button onclick="startGame('album-blur')" class="btn btn-primary w-100">
                Play Blur Mode ▶
            </button>
        </div>
    </div>

    <!-- Game 3: Guess the Album (Color Mode) -->
    <div class="game-card">
        <span class="game-card-badge">Color palette</span>
        <div>
            <div class="game-card-icon">🎨</div>
            <h3>Guess the Album (Color)</h3>
            <p>
                The cover stays hidden. Recognize the album from its dominant colors, revealed from a single swatch to the full palette.
            </p>
        </div>
        <div class="game-card-actions">
            <button onclick="startGame('album-color')" class="btn btn-primary w-100">
                Play Color Mode ▶
            </button>
        </div>
    </div>

    <!-- Game 4: Guess the Album (Random Mode) -->
    <div class="game-card">
        <span class="game-card-badge" style="background: rgba(234, 179, 8, 0.2); color: #facc15; border-color: rgba(234, 179, 8, 0.4);">
            Surprise
        </span>
        <div>
            <div class="game-card-icon">🎲</div>
            <h3>Guess the Album (Random)</h3>
            <p>
                You never know which challenge is next. Each round picks Blur or Color at random.
            </p>
        </div>
        <div class="game-card-actions">
            <button onclick="startGame('album-random')" class="btn btn-primary w-100">
                Play Random Mode ▶
            </button>
        </div>
    </div>

    <!-- Game 5: Finish the Lyric -->
    <div class="game-card">
        <span class="game-card-badge" style="background: rgba(16, 185, 129, 0.2); color: #6ee7b7; border-color: rgba(16, 185, 129, 0.4);">
            New! Lyrics
        </span>
        <div>
            <div class="game-card-icon">✍️</div>
            <h3>Finish the Lyric</h3>
            <p>
                Finish the missing line of a famous chorus, not just the next word. Pick from 4 choices, or type the whole line on hard mode.
            </p>
        </div>
        <div class="game-card-actions d-flex gap-2">
            <button onclick="startGame('lyrics-easy')" class="btn btn-primary flex-grow-1">
                Easy (choices) ▶
            </button>
            <button onclick="startGame('lyrics-hard')" class="btn btn-outline-light flex-grow-1">
                Hard ⌨
            </button>
        </div>
    </div>

    <!-- Game 6: Daily Challenge -->
    <div class="game-card">
        <span class="game-card-badge" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; border-color: rgba(245, 158, 11, 0.4);">
            @(Model.HasPlayedDailyToday ? "✅ Done today" : "Daily")
        </span>
        <div>
            <div class="game-card-icon">📅</div>
            <h3>Daily Challenge</h3>
            <p>
                The same music challenge for everyone today. You get one attempt, so make it count on the daily leaderboard.
            </p>
        </div>
        <div class="game-card-actions">
            @if (Model.HasPlayedDailyToday)
            {
                <a asp-action="DailyChallenge" class="btn btn-outline-warning w-100">
                    See today's result (@Model.TodayDailyScore pts) 🏅
                </a>
            }
            else
            {
                <a asp-action="DailyChallenge" class="btn btn-warning text-dark fw-bold w-100">
                    Play today's challenge ▶
                </a>
            }
        </div>
    </div>
</div>

<!-- Leaderboard & Recent History Section -->
<div class="row g-4 mt-2 mb-5">
    <div class="col-md-6">
        <div class="card p-3 h-100" style="background: #171a21; border: 1px solid rgba(255,255,255,0.08); border-radius: 16px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="m-0 fw-bold">🕒 Your recent games</h4>
                @if (Model.IsAuthenticated)
                {
                    <a asp-action="Stats" class="small text-info text-decoration-underline">See full history</a>
                }
            </div>
            @if (Model.RecentScores.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var s in Model.RecentScores)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center bg-transparent text-light border-secondary px-0 py-2">
                            <div>
                                <span class="fw-bold">@s.GameType</span>
                                <div class="text-muted small">@s.PlayedAt.ToLocalTime().ToString("g") • Correct: @s.CorrectAnswers / @s.TotalRounds</div>
                            </div>
                            <span class="badge bg-success fs-6">@s.Score pts</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No games yet. Pick a mode above and start.</p>
            }
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3 h-100 d-flex flex-column justify-content-between" style="background: #171a21; border: 1px solid rgba(255,255,255,0.08); border-radius: 16px;">
            <div>
                <h4 class="mb-2 fw-bold">🏆 Top players and leaderboards</h4>
                <p class="text-muted">See the best music fans in the NextVibe community for each game mode.</p>
            </div>
            <div class="d-flex gap-2 mt-3">
                <a asp-controller="Games" asp-action="Leaderboard" class="btn btn-outline-light flex-grow-1" style="border-radius: 12px;">
                    Overall leaderboard 🏅
                </a>
                <a asp-controller="Games" asp-action="Leaderboard" asp-route-gameType="DailyChallenge" class="btn btn-outline-warning flex-grow-1" style="border-radius: 12px;">
                    Daily Challenge 📅
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Navigate to the selected game
        function startGame(type, mode) {
            const artistId = document.getElementById('artistSelect').value;
            let url = '';

            if (type === 'song') {
                url = '@Url.Action("GuessSong", "Games")';
                if (mode) {
                    url += (url.includes('?') ? '&' : '?') + 'inputMode=' + mode;
                }
            } else if (type === 'album-blur') {
                url = '@Url.Action("GuessAlbum", "Games")?mode=blur';
            } else if (type === 'album-color') {
                url = '@Url.Action("GuessAlbum", "Games")?mode=color';
            } else if (type === 'album-random') {
                url = '@Url.Action("GuessAlbum", "Games")?mode=random';
            } else if (type === 'lyrics-easy') {
                url = '@Url.Action("FinishLyric", "Games")?difficulty=Easy';
            } else if (type === 'lyrics-hard') {
                url = '@Url.Action("FinishLyric", "Games")?difficulty=Hard';
            }

            if (artistId && type !== 'daily') {
                url += (url.includes('?') ? '&' : '?') + 'artistId=' + encodeURIComponent(artistId);
            }

            window.location.href = url;
        }
    </script>
}
