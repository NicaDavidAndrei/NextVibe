@model IEnumerable<NextVibe.Models.Genre>

@{
    ViewData["Title"] = "Genres";
}

<div class="py-5">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">Genres</h1>
            <p class="text-muted mb-0">
                Explore music genres and discover artists by style.
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Manage" class="btn btn-outline-light">
                Manage Genres
            </a>
        }
    </div>

    <div class="card bg-dark text-white border-secondary shadow-sm mb-4">
        <div class="card-body p-4">
            <form asp-action="Index" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-10">
                        <label class="form-label">Search genres</label>
                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control bg-black text-white border-secondary"
                               placeholder="Search by genre name or description..." />
                    </div>

                    <div class="col-12 col-md-2">
                        <button type="submit" class="btn btn-primary nv-btn-primary w-100">
                            Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card bg-dark text-white border-secondary shadow-sm">
            <div class="card-body text-center p-5">
                <img src="~/images/logo-icon.png" alt="NextVibe" class="nv-badge-img mx-auto mb-3 d-block" style="height:56px;width:auto;" />
                <h2 class="h5 fw-bold mb-2">No genres available</h2>
                <p class="text-muted mb-0">
                    Genres will appear here once they are added.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var genre in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card bg-dark text-white border-secondary h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">

                            <div class="genre-icon mb-3">
                                @{
                                    var icon = genre.Name switch
                                    {
                                        "Hip-Hop" => "🎤",
                                        "Pop" => "🎶",
                                        "Rock" => "🎸",
                                        "Electronic" => "🎧",
                                        "R&B" => "🎷",
                                        "Indie" => "🌿",
                                        "Alternative" => "🎭",
                                        "Trap" => "💣",
                                        "Psychedelic" => "🌌",
                                        "Soul" => "❤️",
                                        _ => "🎵"
                                    };
                                }
                                @icon
                            </div>

                            <h5 class="fw-bold mb-2">@genre.Name</h5>

                            <p class="text-muted flex-grow-1">
                                @(string.IsNullOrWhiteSpace(genre.Description)
                                    ? "No description available."
                                    : genre.Description)
                            </p>

                            <a asp-controller="Explore"
                                   asp-action="Index"
                                   asp-route-genreId="@genre.Id"
                                   class="btn btn-sm btn-primary nv-btn-primary mt-auto">
                                Explore Artists
                            </a>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>