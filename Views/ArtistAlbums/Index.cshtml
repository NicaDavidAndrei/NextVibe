@model IEnumerable<NextVibe.Models.ArtistAlbum>

@{
    ViewData["Title"] = "Albums";
    string? searchString = ViewBag.SearchString as string;
}

<div class="py-5">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">Albums</h1>
            <p class="text-muted mb-0">
                Explore albums from different artists and discover their discographies.
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Manage" class="btn btn-outline-light">
                Manage Albums
            </a>
        }
    </div>

    <div class="card bg-dark text-white border-secondary shadow-sm mb-4">
        <div class="card-body p-4">
            <form asp-action="Index" method="get">
                <div class="row g-3 align-items-end">

                    <div class="col-12 col-md-10">
                        <label class="form-label">Search albums</label>
                        <input type="text"
                               name="searchString"
                               value="@searchString"
                               class="form-control nv-input"
                               placeholder="Search by album, artist or description..." />
                    </div>

                    <div class="col-12 col-md-2">
                        <button type="submit" class="btn btn-primary nv-btn-primary w-100">
                            Search
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card bg-dark text-white border-secondary shadow-sm">
            <div class="card-body text-center p-4">
                <h5 class="fw-bold mb-2">No albums found</h5>
                <p class="text-muted mb-0">
                    Try searching for another album or artist.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var album in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card bg-dark text-white border-secondary h-100 shadow-sm">

                        @if (!string.IsNullOrWhiteSpace(album.CoverImageUrl))
                        {
                            <img src="@album.CoverImageUrl"
                                 class="card-img-top"
                                 alt="@album.Title"
                                 style="height: 240px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-secondary text-white"
                                 style="height: 240px;">
                                No Cover
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="fw-bold mb-1">@album.Title</h5>

                            <p class="text-muted small mb-2">
                                @(album.Artist?.Name ?? "Unknown artist")
                                @if (album.ReleaseYear.HasValue)
                                {
                                    <span> • @album.ReleaseYear</span>
                                }
                            </p>

                            <p class="text-muted flex-grow-1">
                                @{
                                    var description = string.IsNullOrWhiteSpace(album.Description)
                                        ? "No description available."
                                        : album.Description;

                                    if (description.Length > 140)
                                    {
                                        description = description.Substring(0, 140) + "...";
                                    }
                                }
                                @description
                            </p>

                            @if (album.Tracks != null && album.Tracks.Any(t => t.IsTopTrack))
                            {
                                <div class="mt-3">
                                    <h6 class="fw-bold mb-2">Top Tracks</h6>

                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var track in album.Tracks
                                            .Where(t => t.IsTopTrack)
                                            .OrderBy(t => t.TrackNumber)
                                            .Take(3))
                                        {
                                            <div class="bg-black border border-secondary rounded px-3 py-2">
                                                <span class="text-muted me-2">@track.TrackNumber.</span>
                                                <span>@track.Name</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <a asp-controller="ArtistAlbums"
                                   asp-action="Details"
                                   asp-route-id="@album.Id"
                                   class="btn btn-outline-light btn-sm mt-3 w-100">
                                View Full Tracklist
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>