@model NextVibe.Models.ArtistAlbum

@{
    ViewData["Title"] = "Album Details";
}

<div class="py-5">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">Album Details</h1>
            <p class="text-muted mb-0">
                View album information and full tracklist.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-light">
            Back to Albums
        </a>
    </div>

    <div class="card bg-dark text-white border-secondary shadow-sm">
        <div class="card-body p-4">

            <div class="row g-4 align-items-start">

                <div class="col-12 col-md-4">
                    @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                    {
                        <img src="@Model.CoverImageUrl"
                             alt="@Model.Title"
                             class="img-fluid rounded"
                             style="width: 100%; max-height: 420px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-secondary text-white rounded"
                             style="height: 320px;">
                            No Cover
                        </div>
                    }
                </div>

                <div class="col-12 col-md-8">
                    <h2 class="fw-bold mb-2">@Model.Title</h2>

                    <p class="text-muted mb-3">
                        @(Model.Artist?.Name ?? "Unknown artist")
                        @if (Model.ReleaseYear.HasValue)
                        {
                            <span> • @Model.ReleaseYear</span>
                        }
                    </p>

                    <h5 class="fw-bold mb-2">Description</h5>
                    <p class="text-muted mb-0">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "No description available."
                            : Model.Description)
                    </p>
                </div>

            </div>

        </div>
    </div>

    <div class="card bg-dark text-white border-secondary shadow-sm mt-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-4">Tracklist</h4>

            @if (Model.Tracks != null && Model.Tracks.Any())
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var track in Model.Tracks.OrderBy(t => t.TrackNumber))
                    {
                        var minutes = track.DurationSeconds.HasValue ? track.DurationSeconds.Value / 60 : 0;
                        var seconds = track.DurationSeconds.HasValue ? track.DurationSeconds.Value % 60 : 0;
                        var duration = track.DurationSeconds.HasValue && track.DurationSeconds.Value > 0
                            ? string.Format("{0}:{1:00}", minutes, seconds)
                            : "—";

                        <div class="d-flex justify-content-between align-items-center bg-black border border-secondary rounded px-3 py-3">
                            <div>
                                <span class="text-muted me-3">
                                    @track.TrackNumber.
                                </span>

                                <span class="fw-semibold">
                                    @track.Name
                                </span>
                            </div>

                            <div class="d-flex align-items-center gap-3">
                                <span class="text-muted small">
                                    @duration
                                </span>

                                @if (track.IsTopTrack)
                                {
                                    <span class="badge rounded-pill nv-pill">
                                        Top Track
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No tracks added for this album yet.
                </p>
            }
        </div>
    </div>

</div>