@model NextVibe.Models.ArtistMood

@{
    ViewData["Title"] = "Create Artist Mood";
}

<div class="py-5">
    <h1 class="h3 fw-bold mb-4">Create Artist Mood</h1>

    <div class="card bg-dark text-white border-secondary shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ArtistId" class="form-label">Artist</label>
                    <select asp-for="ArtistId" class="form-select nv-input" asp-items="ViewBag.ArtistId"></select>
                    <span asp-validation-for="ArtistId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MoodId" class="form-label">Mood</label>
                    <select asp-for="MoodId" class="form-select nv-input" asp-items="ViewBag.MoodId"></select>
                    <span asp-validation-for="MoodId" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary nv-btn-primary">
                        Create
                    </button>

                    <a asp-action="Index" class="btn btn-outline-light">
                        Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}