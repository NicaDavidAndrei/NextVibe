@model IEnumerable<NextVibe.Models.UserFavoriteArtist>

@{
    ViewData["Title"] = "Favorites";

    var userType = Context.Request.Query["userType"].ToString();
    if (string.IsNullOrWhiteSpace(userType))
    {
        userType = "Guest";
    }
}

<div class="py-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Favorites</h1>
            <p class="text-muted mb-0">
                Inspect the saved favorite artists for users.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Admin"
                   asp-action="Index"
                   asp-route-userType="@userType"
                   class="btn btn-outline-light">
                Back to Admin Panel
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card bg-dark text-white border-secondary shadow-sm">
            <div class="card-body p-5 text-center">
                <img src="~/images/logo-icon.png" alt="NextVibe" class="nv-badge-img mx-auto mb-3 d-block" style="height:56px;width:auto;" />
                <h2 class="h5 fw-bold mb-2">No favorites found</h2>
                <p class="text-muted mb-0">
                    No user has saved any favorite artists yet.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card bg-dark text-white border-secondary shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="px-4 py-3">User</th>
                                <th class="px-4 py-3">Artist</th>
                                <th class="px-4 py-3">Added At</th>
                                <th class="px-4 py-3 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3 fw-semibold">
                                        @(item.User != null
                                            ? $"{item.User.FirstName} {item.User.LastName}"
                                            : "Unknown user")
                                    </td>

                                    <td class="px-4 py-3 text-muted">
                                        @(item.Artist?.Name ?? "Unknown artist")
                                    </td>

                                    <td class="px-4 py-3 text-muted">
                                        @item.AddedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td class="px-4 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-2 flex-wrap">
                                            <a asp-action="Details"
                                                   asp-route-id="@item.Id"
                                                   asp-route-userType="@userType"
                                                   class="btn btn-sm btn-primary nv-btn-primary">
                                                Details
                                            </a>

                                            <a asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   asp-route-userType="@userType"
                                                   class="btn btn-sm btn-danger">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

</div>