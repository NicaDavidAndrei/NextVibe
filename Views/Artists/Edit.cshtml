@model NextVibe.Models.Artist

@{
    ViewData["Title"] = "Edit Artist";

    var userType = Context.Request.Query["userType"].ToString();
    if (string.IsNullOrWhiteSpace(userType))
    {
        userType = "Admin";
    }
}

<div class="py-5">

    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Edit Artist</h1>
        <p class="text-muted mb-0">
            Update the selected artist information.
        </p>
    </div>

    <div class="card bg-dark text-white border-secondary shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" name="userType" value="@userType" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control nv-input" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="GenreId" class="form-label">Genre</label>
                        <select asp-for="GenreId" class="form-select nv-input" asp-items="ViewBag.GenreId"></select>
                        <span asp-validation-for="GenreId" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Bio" class="form-label"></label>
                        <textarea asp-for="Bio" class="form-control nv-input" rows="4"></textarea>
                        <span asp-validation-for="Bio" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="ImageUrl" class="form-label"></label>
                        <input asp-for="ImageUrl" class="form-control nv-input" />
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-3">
                        <label asp-for="Country" class="form-label"></label>
                        <input asp-for="Country" class="form-control nv-input" />
                        <span asp-validation-for="Country" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-3">
                        <label asp-for="BirthYear" class="form-label"></label>
                        <input asp-for="BirthYear" class="form-control nv-input" />
                        <span asp-validation-for="BirthYear" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4 flex-wrap">
                    <button type="submit" class="btn btn-primary nv-btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Index"
                           asp-route-userType="@userType"
                           class="btn btn-outline-light">
                        Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}