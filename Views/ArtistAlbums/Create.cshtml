@model NextVibe.Models.ArtistAlbum

@{
    ViewData["Title"] = "Add Album";
}

<div class="py-5">

    <h1 class="h3 fw-bold mb-4">Add Album</h1>

    <div class="card bg-dark text-white border-secondary shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Create">

                <div class="mb-3">
                    <label asp-for="ArtistId" class="form-label">Artist</label>
                    <select asp-for="ArtistId" class="form-select nv-input" asp-items="ViewBag.ArtistId"></select>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control nv-input" />
                </div>

                <div class="mb-3">
                    <label asp-for="ReleaseYear" class="form-label"></label>
                    <input asp-for="ReleaseYear" class="form-control nv-input" />
                </div>

                <div class="mb-3">
                    <label asp-for="CoverImageUrl" class="form-label"></label>
                    <input asp-for="CoverImageUrl" class="form-control nv-input" placeholder="/images/albums/album-cover.jpg" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control nv-input"></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary nv-btn-primary">Create</button>
                    <a asp-action="Index" class="btn btn-outline-light">Cancel</a>
                </div>

            </form>

        </div>
    </div>

</div>