@model IEnumerable<NextVibe.Models.Mood>

@{
    ViewData["Title"] = "Manage Moods";
}

<div class="py-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Manage Moods</h1>
            <p class="text-muted mb-0">
                Create, edit and delete moods used for artist categorization.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-light">
                Back to Moods
            </a>

            <a asp-action="Create" class="btn btn-primary nv-btn-primary">
                Create New
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card bg-dark text-white border-secondary shadow-sm">
            <div class="card-body p-5 text-center">
                <img src="~/images/logo-icon.png" alt="NextVibe" class="nv-badge-img mx-auto mb-3 d-block" style="height:56px;width:auto;" />
                <h2 class="h5 fw-bold mb-2">No moods found</h2>
                <p class="text-muted mb-4">
                    Start by adding the first mood to the database.
                </p>

                <a asp-action="Create" class="btn btn-primary nv-btn-primary">
                    Create First Mood
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card bg-dark text-white border-secondary shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="px-4 py-3">Name</th>
                                <th class="px-4 py-3">Description</th>
                                <th class="px-4 py-3 text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3 fw-semibold">@item.Name</td>

                                    <td class="px-4 py-3 text-muted">
                                        @(string.IsNullOrWhiteSpace(item.Description)
                                            ? "No description available."
                                            : item.Description)
                                    </td>

                                    <td class="px-4 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-2 flex-wrap">
                                            <a asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-light">
                                                Edit
                                            </a>

                                            <a asp-action="Details"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-primary nv-btn-primary">
                                                Details
                                            </a>

                                            <a asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-danger">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>
    }

</div>